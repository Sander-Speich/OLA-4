myMapPlot <- function(df) {
  
  df <- df[
    !is.na(df$lat) & !is.na(df$lng),
  ]
  
  leaflet(df) %>%
    addTiles() %>%
    addPolylines(
      lat = ~lat,
      lng = ~lng
    )
}

