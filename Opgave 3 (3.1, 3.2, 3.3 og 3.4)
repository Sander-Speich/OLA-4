# Funktion til at hente track for ét fly

getFlightTrack <- function(icaoId, token) {
  
  totUrl <- paste0(
    baseurl,
    endpointTrack,
    "?icao24=", icaoId,
    "&time=0"
  )
  
  test2 <- tryCatch(
    httr::GET(
      totUrl,
      add_headers(
        Authorization = paste("Bearer", token)
      ),
      timeout(30)
    ),
    error = function(e) NULL
  )
  
  if (is.null(test2)) {
    return(NULL)
  }
  
  if (test2$status_code != 200) {
    message(
      "Fly ", icaoId,
      " - status: ", test2$status_code
    )
    return(NULL)
  }
  
  rawtext2 <- httr::content(
    test2, as = "text"
  )
  
  myJason2 <- jsonlite::fromJSON(rawtext2)
  
  if (is.null(myJason2$path)) {
    return(NULL)
  }
  
  dfFlights2 <- as.data.frame(
    myJason2$path
  )
  
  if (nrow(dfFlights2) == 0 ||
      ncol(dfFlights2) != 6) {
    return(NULL)
  }
  
  df2Names <- c(
    "time",
    "latitude",
    "longitude",
    "baro_altitude",
    "true_track",
    "on_ground"
  )
  
  colnames(dfFlights2) <- df2Names
  
  for (v in c(
    "time", "latitude", "longitude",
    "baro_altitude", "true_track"
  )) {
    dfFlights2[[v]] <- as.numeric(
      dfFlights2[[v]]
    )
  }
  
  return(dfFlights2)
}


