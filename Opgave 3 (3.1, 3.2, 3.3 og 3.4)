# 1. Frisk liste af fly over Nordsøen
token=getToken()
res <- httr::GET(toturl, add_headers(Authorization = paste("Bearer", token)))
resretval <- jsonlite::fromJSON(httr::content(res, as="text", encoding="UTF-8"))
statedfpr <- as.data.frame(resretval$states)
icaov=statedfpr$V1
length(icaov)


# 2. Loop gennem alle fly
colnv=c("icao24","callsign","startTime","endTime","time","lat","lng","alt","crs","grd")
tracklist=list()
resdf=data.frame()

for (ic in icaov) {
  turl=paste0(baseurl,endpointTrack,"?icao24=",ic,"&time=0")
  res <- httr::GET(turl, add_headers(Authorization = paste("Bearer", token)))
  if (res$status_code == 401) {
    token=getToken()
  }
  if (res$status_code == 200) {
    resretval <- fromJSON(content(res, as="text", encoding="UTF-8"))
    trackdf <- as.data.frame(resretval)
    if (ncol(trackdf) == 10) {
      colnames(trackdf)=colnv
      dcrs=diff(trackdf$crs)
      dcrs=(dcrs + 180) %% 360 - 180
      trackdf$dcrs=c(0,dcrs)
      tracklist[[ic]]=trackdf
      resdf=rbind(resdf, data.frame(icao=ic, sdcourse=sd(dcrs, na.rm=TRUE),
                                    lmres=0, myOwnAlg=0, isOff=0))
    }
  }
  Sys.sleep(1)
}


# 3. Lærerens cirklende fly
resdf=resdf[resdf$isOff==0, ]   # fjern evt. gamle cirklende fly, så de ikke kommer med to gange

fl=list.files(path="./train", pattern="\\.rds$", full.names=TRUE)
fl=fl[!grepl("norm", fl)]       # det normale fly skal ikke med

for (f in fl) {
  df=readRDS(f)
  dcrs=diff(df$crs)
  dcrs=(dcrs + 180) %% 360 - 180
  resdf=rbind(resdf, data.frame(icao=df$icao24[1], sdcourse=sd(dcrs, na.rm=TRUE),
                                lmres=0, myOwnAlg=0, isOff=1))
}


# 4. Se og gem resultatet
table(resdf$isOff)
View(resdf)
saveRDS(tracklist,"mytracks.rds")
saveRDS(resdf,"resdf.rds")

# Billede: før og efter rettelsen af kursen
cirkel=readRDS("./train/circMT.rds")
tid=(cirkel$time - min(cirkel$time)) / 60
dcrs=diff(cirkel$crs)
dcrs=(dcrs + 180) %% 360 - 180

par(mfrow=c(1,2), oma=c(0,0,3,0), mar=c(5,8,4,1))

# Venstre: rå kurs
plot(tid, cirkel$crs, type="l", lwd=2, col="grey30", ylim=c(0,360), yaxt="n",
     main="Før: flyets kurs", xlab="Tid (minutter fra flyets start)", ylab="")
axis(2, at=c(0,90,180,270,360), labels=c("Nord","Øst","Syd","Vest","Nord"), las=1)
mtext("Flyets retning", side=2, line=5)
rect(19.5, 0, 33.5, 360, col=adjustcolor("firebrick", 0.15), border=NA)
text(55, 150, "De lodrette streger er ikke\nrigtige drej – kursen springer\nbare fra 0 til 360, når\nflyet passerer nord", cex=0.8)

# Højre: rettet kursændring
plot(tid[-1], dcrs, type="l", lwd=2, col="firebrick", ylim=c(-15,15), yaxt="n",
     main="Efter: hvor meget flyet drejer", xlab="Tid (minutter fra flyets start)", ylab="")
axis(2, at=c(-10,0,10), labels=c("10° venstre","Ligeud","10° højre"), las=1)
mtext("Drej mellem to målinger", side=2, line=6)
abline(h=0, lty=2, col="grey50")
rect(19.5, -15, 33.5, 15, col=adjustcolor("firebrick", 0.15), border=NA)
text(55, -10, "Rødt felt: flyet drejer\nhele tiden til venstre\n= det cirkler", cex=0.8)

mtext("Hvorfor vi retter kursen – lærerens cirklende fly (circMT)", outer=TRUE, line=1, font=2, cex=1.2)
par(mfrow=c(1,1), oma=c(0,0,0,0), mar=c(5,4,4,2))

# ==========================================
# OPGAVE 3.4 - AIM HIGH - EGEN ALGORITME
# ==========================================

lmresv=c()
drejv=c()

# 1. Jeres egne fly
for (df in tracklist) {
  model=lm(lat ~ lng, data=df)
  lmresv=c(lmresv, summary(model)$r.squared)
  
  vend=cumsum(df$dcrs)
  drejv=c(drejv, max(vend, na.rm=TRUE) - min(vend, na.rm=TRUE))
}

# 2. Lærerens cirklende fly
for (f in fl) {
  df=readRDS(f)
  model=lm(lat ~ lng, data=df)
  lmresv=c(lmresv, summary(model)$r.squared)
  
  dcrs=diff(df$crs)
  dcrs=(dcrs + 180) %% 360 - 180
  vend=cumsum(dcrs)
  drejv=c(drejv, max(vend, na.rm=TRUE) - min(vend, na.rm=TRUE))
}

# 3. Sæt resultaterne ind i tabellen
length(lmresv)
nrow(resdf)

resdf$lmres=lmresv
resdf$myOwnAlg=ifelse(drejv >= 360, 1, 0)

# 4. Hvor godt gætter algoritmen?
table(Algoritme=resdf$myOwnAlg, Facit=resdf$isOff)
View(resdf)
View(rbind(head(resdf, 10), tail(resdf, 9)))   # udsnit til rapporten (billede 3)
saveRDS(resdf,"resdf.rds")

# 5. Kig på de fly, algoritmen mener cirkler
resdf[resdf$myOwnAlg==1 & resdf$isOff==0, ]

